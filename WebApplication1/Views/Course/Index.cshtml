@model List<Course>
<br />
<a href="/Course/Add" class="btn btn-primary">New Course</a>
<br />
<br />
<table class="table">
    <thead>
        <tr>
            <th scope="col">Num</th>
            <th scope="col">Name</th>
            <th scope="col">Topic</th>
            <th scope="col">Degree</th>
            <th scope="col">MinDegree</th>
            <th scope="col">Edit</th>
            <th scope="col">delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {

            <tr>
                <th scope="row">@c.Num</th>
                <td>@c.Name</td>
                <td>@c.Topic</td>
                <td>@c.Degree</td>
                <td>@c.MinDegree</td>
                <td><a asp-action="Edit" asp-controller="Course" asp-route-id="@c.Num">Edit</a></td>
                <td><a style="color:red;" asp-action="Delete" asp-controller="Course" asp-route-id="@c.Num">Delete</a></td>
            </tr>

        }
    </tbody>
</table>
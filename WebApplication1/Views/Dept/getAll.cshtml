@model List<Department>

<br />
<a href="/Dept/Add" class="btn btn-primary">New Department</a>
<br />
<br />
<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Manger</th>
         
            <th scope="col">Edit</th>
            <th scope="col">delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dep in Model)
        {

            <tr>
                <th scope="row">@dep.Id</th>
                <td>@dep.Name</td>
                <td>@dep.Manger</td>
             
                <td><a asp-action="Edit" asp-controller="Dept" asp-route-id="@dep.Id">Edit</a></td>
                <td><a style="color:red;" asp-action="Delete" asp-controller="Dept" asp-route-id="@dep.Id">Delete</a></td>
            </tr>

        }      
    </tbody>
</table>

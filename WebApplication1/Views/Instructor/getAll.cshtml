@model List<Instructor>
<br />
<a href="/Instructor/Add" class="btn btn-primary">New Instructor</a>
<br />
<br />
<table class="table">
    <thead>
        <tr>
            <th scope="col">SSN</th>
            <th scope="col">Name</th>
            <th scope="col">Age</th>
            <th scope="col">Address</th>
            <th scope="col">Salary</th>
            <th scope="col">Department</th>
            <th scope="col">Edit</th>
            <th scope="col">delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Instructor std in Model)
        {

            <tr>
                <th scope="row">@std.SSN</th>
                <td>@std.Name</td>
                <td>@std.Age</td>
                <td>@std.Address</td>
                <td>@std.Salary</td>
                <td>@std.Department?.Name</td>
                <td><a asp-action="Edit" asp-controller="Instructor" asp-route-id="@std.SSN">Edit</a></td>
                <td><a style="color:red;" asp-action="Delete" asp-controller="Instructor" asp-route-id="@std.SSN">Delete</a></td>
            </tr>

        }
    </tbody>
</table>
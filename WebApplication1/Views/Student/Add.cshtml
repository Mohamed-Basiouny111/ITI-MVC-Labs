@model Student

<form action="/Student/AddNew">
    <div class="form-group">
        <label for="exampleInputEmail1">Name</label>
        <input type="text" class="form-control" name="Name" value="@Model?.Name">

    </div>
    <div class="form-group">
        <label for="exampleInputPassword1">Age</label>
        <input type="number" class="form-control" name="Age" value="@Model?.Age">
    </div>
    <div class="form-group">
        <label for="">Address</label>
        <input type="text" class="form-control" name="Address" value="@Model?.Address">

    </div>
    <div class="form-group">
        <label for="">DeptId</label>
        <input type="number" class="form-control" name="DeptId" value="@Model?.DeptId">

    </div>
    <div class="form-group">
        <label for="">Image</label>
        <input type="text" class="form-control" name="Email" value="@Model?.Image">

    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>